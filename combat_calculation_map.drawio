<mxfile host="65bd71144e">
    <diagram id="blackout-combat-calc" name="Combat calculation">
        <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="A" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="35" y="290" width="1750" height="457" as="geometry"/></mxCell>
                <mxCell id="B" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="1840" y="290" width="1780" height="457" as="geometry"/></mxCell>
                <mxCell id="C" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="3685" y="290" width="1470" height="457" as="geometry"/></mxCell>
                <mxCell id="D" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="5225" y="147" width="4360" height="1133" as="geometry"/></mxCell>
                <mxCell id="E" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="9680" y="100" width="4135" height="848" as="geometry"/></mxCell>
                <mxCell id="U" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="35" y="1410" width="2210" height="318" as="geometry"/></mxCell>
                <mxCell id="P1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="2325" y="1410" width="800" height="642" as="geometry"/></mxCell>
                <mxCell id="P2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="3185" y="1410" width="980" height="608" as="geometry"/></mxCell>
                <mxCell id="P3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="4225" y="1410" width="760" height="638" as="geometry"/></mxCell>
                <mxCell id="P4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="5045" y="1410" width="760" height="586" as="geometry"/></mxCell>
                <mxCell id="P5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;" parent="1" vertex="1"><mxGeometry x="5865" y="1410" width="620" height="384" as="geometry"/></mxCell>
                <mxCell id="P6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="6545" y="1410" width="620" height="450" as="geometry"/></mxCell>
                <mxCell id="A_t" value="1. Queue phase: the command arrives (queue_action, _validate_attack)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="47" y="298" width="1726" height="28" as="geometry"/></mxCell>
                <mxCell id="B_t" value="2. Tick gate: BlackoutCombatHandler.tick, each 0.6 s tick, for each combatant" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="1852" y="298" width="1756" height="28" as="geometry"/></mxCell>
                <mxCell id="C_t" value="3. Pre-roll phase: _build_context, then resolve_action" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="3697" y="298" width="1446" height="28" as="geometry"/></mxCell>
                <mxCell id="D_t" value="4. Action calculation phase: the nine seams (rules/pipeline.py, base_rules.py, combat_calc.py)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="5237" y="155" width="4336" height="28" as="geometry"/></mxCell>
                <mxCell id="E_t" value="5. Resolve phase: ActionAttack.resolve, after the calculation" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="9692" y="108" width="4111" height="28" as="geometry"/></mxCell>
                <mxCell id="U_t" value="6. Aura pulse: BlackoutAuraHandler.tick. It is outside the rules pipeline. Unlock for Righteous Fire: Fortitude 25" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=20;" parent="1" vertex="1"><mxGeometry x="47" y="1418" width="2186" height="28" as="geometry"/></mxCell>
                <mxCell id="P1_t" value="Modifier channels and the three appliers" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="2337" y="1418" width="776" height="28" as="geometry"/></mxCell>
                <mxCell id="P2_t" value="Who writes a channel today" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="3197" y="1418" width="956" height="28" as="geometry"/></mxCell>
                <mxCell id="P3_t" value="Combat axes and combat styles" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4237" y="1418" width="736" height="28" as="geometry"/></mxCell>
                <mxCell id="P4_t" value="The nine seams and the priority tiers" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="5057" y="1418" width="736" height="28" as="geometry"/></mxCell>
                <mxCell id="P5_t" value="HP, regen, reach, and combat level" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="5877" y="1418" width="596" height="28" as="geometry"/></mxCell>
                <mxCell id="P6_t" value="Declared, but not wired today" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=16;" parent="1" vertex="1"><mxGeometry x="6557" y="1418" width="596" height="28" as="geometry"/></mxCell>
                <mxCell id="D_acc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1"><mxGeometry x="5250" y="207" width="1840" height="489" as="geometry"/></mxCell>
                <mxCell id="D_dmg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1"><mxGeometry x="7130" y="207" width="1840" height="489" as="geometry"/></mxCell>
                <mxCell id="D_ovr" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" parent="1" vertex="1"><mxGeometry x="5250" y="795" width="3720" height="460" as="geometry"/></mxCell>
                <mxCell id="D_def" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" parent="1" vertex="1"><mxGeometry x="9010" y="207" width="550" height="1048" as="geometry"/></mxCell>
                <mxCell id="E_pay" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" parent="1" vertex="1"><mxGeometry x="10480" y="385" width="840" height="205" as="geometry"/></mxCell>
                <mxCell id="E_dmg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" parent="1" vertex="1"><mxGeometry x="11350" y="390" width="1315" height="511" as="geometry"/></mxCell>
                <mxCell id="D_acc_t" value="Accuracy" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="5262" y="215" width="1816" height="28" as="geometry"/></mxCell>
                <mxCell id="D_dmg_t" value="Damage roll" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="7142" y="215" width="1816" height="28" as="geometry"/></mxCell>
                <mxCell id="D_ovr_t" value="Rule overrides: a contributor replaces a seam" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="5262" y="803" width="3696" height="28" as="geometry"/></mxCell>
                <mxCell id="D_def_t" value="Damage reduction: the defender pass" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="9022" y="215" width="526" height="28" as="geometry"/></mxCell>
                <mxCell id="E_pay_t" value="Announce and pay (_land_hit)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="10492" y="393" width="816" height="28" as="geometry"/></mxCell>
                <mxCell id="E_dmg_t" value="Damage application: CombatEntity.at_damage. The backfire and the aura pulse call it too" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=14;" parent="1" vertex="1"><mxGeometry x="11362" y="398" width="1291" height="28" as="geometry"/></mxCell>
                <mxCell id="a0" value="&lt;b&gt;attack&lt;/b&gt; command,&lt;br&gt;or an NPC behaviour&lt;br&gt;&lt;b&gt;queue_action&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="455" width="180" height="90" as="geometry"/></mxCell>
                <mxCell id="a1" value="Is the target a &lt;b&gt;Combatant&lt;/b&gt;, and alive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="280" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="a2" value="&lt;b&gt;PvP rule&lt;/b&gt;: if both are players, is &lt;b&gt;pvp_enabled&lt;/b&gt; on for both?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="520" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="a3" value="&lt;b&gt;can_strike&lt;/b&gt;: in reach, and in sight above melee reach?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="760" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="a4" value="&lt;b&gt;ammunition.check&lt;/b&gt;: does the equipped ammo fit the weapon?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="1000" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="a5" value="&lt;b&gt;start_combat_state&lt;/b&gt;&lt;br&gt;The target gets a combat handler. The client turns the two to face (&lt;b&gt;blackout_face&lt;/b&gt;)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="1250" y="463" width="230" height="74" as="geometry"/></mxCell>
                <mxCell id="a6" value="The tick engine holds the action. At the top of the next tick, &lt;b&gt;apply_action&lt;/b&gt; sets &lt;i&gt;pending_action&lt;/i&gt; = ActionAttack and &lt;i&gt;target_id&lt;/i&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="1520" y="463" width="240" height="74" as="geometry"/></mxCell>
                <mxCell id="a_ref" value="&lt;b&gt;Refused.&lt;/b&gt; The attacker gets the reason at once. Nothing enters the queue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="280" y="678" width="930" height="44" as="geometry"/></mxCell>
                <mxCell id="a_note" value="&lt;i&gt;reach&lt;/i&gt; = weapon &lt;b&gt;max_range&lt;/b&gt; + style &lt;b&gt;range_bonus&lt;/b&gt; (snipe +2). Melee and bare hands reach 0, the same tile. A shot needs line of sight and never crosses planes. A melee weapon needs no ammunition." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="280" y="350" width="930" height="60" as="geometry"/></mxCell>
                <mxCell id="b1" value="Is the combatant alive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="1875" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b2" value="&lt;b&gt;check_stop_combat&lt;/b&gt;: a live enemy engaged inside 12 tiles?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="2125" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b3" value="&lt;i&gt;cooldown_ticks&lt;/i&gt; &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="2375" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b4" value="Is there a &lt;i&gt;pending_action&lt;/i&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="2625" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b5" value="&lt;b&gt;is_stalled&lt;/b&gt;: target alive, but not &lt;b&gt;can_strike&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="2875" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b6" value="Is the target usable (exists, alive)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="3125" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b7" value="&lt;b&gt;ammunition.check&lt;/b&gt; passes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="3375" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="b1x" value="&lt;b&gt;ACTOR_INCAPACITATED&lt;/b&gt;&lt;br&gt;The fight ends for this combatant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="1865" y="677" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="b2x" value="&lt;b&gt;Grace&lt;/b&gt;: wait &lt;b&gt;OUT_OF_REACH_GRACE_TICKS&lt;/b&gt; (4), then &amp;quot;You won!&amp;quot;. No grace for an enemy that is dead or on another map." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="2115" y="663" width="230" height="74" as="geometry"/></mxCell>
                <mxCell id="b3x" value="&lt;i&gt;cooldown_ticks&lt;/i&gt; = &lt;i&gt;cooldown_ticks&lt;/i&gt; - 1&lt;br&gt;Wait for the next tick." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="2365" y="677" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="b4x" value="Ask the controller (&lt;b&gt;ai_behavior&lt;/b&gt;). A player has none and idles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="2615" y="677" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="b5x" value="&lt;b&gt;Hold.&lt;/b&gt; No resolve and no cooldown. An NPC steps toward the target." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="2865" y="677" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="b6x" value="&lt;b&gt;TARGET_INVALID&lt;/b&gt;&lt;br&gt;Release the target." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="3115" y="677" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="b7x" value="&lt;b&gt;RESOURCES_EXHAUSTED&lt;/b&gt;&lt;br&gt;The fight ends. No wait refills a quiver." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="3365" y="670" width="230" height="60" as="geometry"/></mxCell>
                <mxCell id="c1" value="&lt;b&gt;Snapshot the ActionContext&lt;/b&gt;&lt;br&gt;&lt;i&gt;style&lt;/i&gt;, &lt;i&gt;attack_type&lt;/i&gt;: from the wielded weapon, from the stat block of an NPC, or from bare hands (punch, crush, 4 ticks).&lt;br&gt;&lt;i&gt;attacker_stats&lt;/i&gt;: the sum of &lt;b&gt;combat_stat_bonuses&lt;/b&gt; over every equipped slot.&lt;br&gt;&lt;i&gt;defender_stats&lt;/i&gt;: the same sum for the target.&lt;br&gt;&lt;i&gt;attacker_levels&lt;/i&gt;, &lt;i&gt;defender_levels&lt;/i&gt;: the combat skill levels, read one time.&lt;br&gt;&lt;i&gt;stance_boost&lt;/i&gt;: &lt;b&gt;weapon_style_level_boost&lt;/b&gt; of the style." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="3710" y="407" width="270" height="186" as="geometry"/></mxCell>
                <mxCell id="c2" value="&lt;b&gt;Collect the contributors&lt;/b&gt; of each side&lt;br&gt;1. Gear: &lt;b&gt;combat_rules&lt;/b&gt; of each equipped item, in slot order. An NPC names its own.&lt;br&gt;2. Exterminator buffs that apply to the creature type of the other side.&lt;br&gt;3. Lit augments.&lt;br&gt;Sort by priority, lowest first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="4020" y="435" width="260" height="130" as="geometry"/></mxCell>
                <mxCell id="c3" value="&lt;b&gt;Pick the winner of each seam&lt;/b&gt;&lt;br&gt;Only the contributors of the ATTACKER compete. The highest priority wins a seam whole. Seams do not chain. A seam with no claim goes to &lt;b&gt;BaseActionRules&lt;/b&gt;, the OSRS default." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="4320" y="449" width="260" height="102" as="geometry"/></mxCell>
                <mxCell id="c4" value="&lt;b&gt;Run contribute_modifiers&lt;/b&gt;&lt;br&gt;Every contributor of each side writes into the bag of its owner: &lt;i&gt;attacker_bag&lt;/i&gt; or &lt;i&gt;defender_bag&lt;/i&gt;. Priority does not matter here. The pipeline logs and skips a contributor that raises." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="4620" y="449" width="260" height="102" as="geometry"/></mxCell>
                <mxCell id="c5" value="Who won the &lt;b&gt;resolve&lt;/b&gt; seam?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="4920" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="d_a1" value="&lt;b&gt;effective_attack_level&lt;/b&gt;&lt;br&gt;&lt;i&gt;eff_atk&lt;/i&gt; = floor( floor( (&lt;i&gt;level&lt;/i&gt; + flat_pre) x (1 + augment_bonus) ) x (1 + set_bonus) ) + stance + flat_post + 8&lt;br&gt;Skill: Strike (melee) or Guns (projectile).&lt;br&gt;Channel: &lt;b&gt;strike_level&lt;/b&gt; or &lt;b&gt;guns_level&lt;/b&gt;, attacker bag." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="5275" y="315" width="270" height="130" as="geometry"/></mxCell>
                <mxCell id="d_a2" value="&lt;i&gt;equip_atk&lt;/i&gt; = apply_to_int( attacker bag, &lt;b&gt;attack_bonus&lt;/b&gt;, &lt;i&gt;attacker_stats&lt;/i&gt;[ {category}_{attack_type}_attack_bonus ] )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="5575" y="343" width="240" height="74" as="geometry"/></mxCell>
                <mxCell id="d_a3" value="&lt;b&gt;attack_roll&lt;/b&gt;&lt;br&gt;&lt;i&gt;R_atk&lt;/i&gt; = &lt;i&gt;eff_atk&lt;/i&gt; x (&lt;i&gt;equip_atk&lt;/i&gt; + 64)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="5845" y="350" width="190" height="60" as="geometry"/></mxCell>
                <mxCell id="d_d1" value="&lt;b&gt;effective_defense_level&lt;/b&gt;&lt;br&gt;&lt;i&gt;eff_def&lt;/i&gt; = the same formula on the Defense level of the DEFENDER.&lt;br&gt;Channel: &lt;b&gt;defense_level&lt;/b&gt;, defender bag.&lt;br&gt;Stance = 0. The style of the attacker never counts here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="5275" y="569" width="270" height="102" as="geometry"/></mxCell>
                <mxCell id="d_d2" value="&lt;i&gt;equip_def&lt;/i&gt; = apply_to_int( defender bag, &lt;b&gt;defense_bonus&lt;/b&gt;, &lt;i&gt;defender_stats&lt;/i&gt;[ {category}_{attack_type}_defense_bonus ] )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="5575" y="583" width="240" height="74" as="geometry"/></mxCell>
                <mxCell id="d_d3" value="&lt;b&gt;defense_roll&lt;/b&gt;&lt;br&gt;&lt;i&gt;R_def&lt;/i&gt; = &lt;i&gt;eff_def&lt;/i&gt; x (&lt;i&gt;equip_def&lt;/i&gt; + 64)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="5845" y="590" width="190" height="60" as="geometry"/></mxCell>
                <mxCell id="d_cmp" value="&lt;b&gt;hit_chance&lt;/b&gt;&lt;br&gt;&lt;i&gt;R_atk&lt;/i&gt; &amp;gt; &lt;i&gt;R_def&lt;/i&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="6075" y="440" width="180" height="120" as="geometry"/></mxCell>
                <mxCell id="d_p1" value="&lt;i&gt;P&lt;/i&gt; = 1 - (&lt;i&gt;R_def&lt;/i&gt; + 2) / (2 x (&lt;i&gt;R_atk&lt;/i&gt; + 1))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="6295" y="355" width="240" height="50" as="geometry"/></mxCell>
                <mxCell id="d_p2" value="&lt;i&gt;P&lt;/i&gt; = &lt;i&gt;R_atk&lt;/i&gt; / (2 x (&lt;i&gt;R_def&lt;/i&gt; + 1))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="6295" y="595" width="240" height="50" as="geometry"/></mxCell>
                <mxCell id="d_clamp" value="&lt;i&gt;hit_prob&lt;/i&gt; = clamp( apply_to_scalar( attacker bag, &lt;b&gt;hit_chance&lt;/b&gt;, &lt;i&gt;P&lt;/i&gt; ), &lt;b&gt;HIT_CHANCE_FLOOR&lt;/b&gt; 0.0, &lt;b&gt;HIT_CHANCE_CEILING&lt;/b&gt; 0.99 )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="6575" y="463" width="240" height="74" as="geometry"/></mxCell>
                <mxCell id="d_roll" value="&lt;b&gt;roll_accuracy&lt;/b&gt;&lt;br&gt;rng.random() &amp;lt; &lt;i&gt;hit_prob&lt;/i&gt;?&lt;br&gt;(first draw)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="6855" y="430" width="200" height="140" as="geometry"/></mxCell>
                <mxCell id="d_miss" value="&lt;b&gt;Miss&lt;/b&gt;: &lt;i&gt;hit&lt;/i&gt; = False, &lt;i&gt;damage&lt;/i&gt; = 0. The defender pass does nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="6845" y="257" width="220" height="46" as="geometry"/></mxCell>
                <mxCell id="d_win" value="Who won the &lt;b&gt;roll_damage&lt;/b&gt; seam?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="7155" y="430" width="210" height="140" as="geometry"/></mxCell>
                <mxCell id="d_s1" value="&lt;b&gt;effective_strength_level&lt;/b&gt;&lt;br&gt;&lt;i&gt;eff_str&lt;/i&gt; = floor( floor( (&lt;i&gt;level&lt;/i&gt; + flat_pre) x (1 + augment_bonus) ) x (1 + set_bonus) ) + stance + flat_post + 8&lt;br&gt;Skill: Brawn or Ballistics.&lt;br&gt;Channel: &lt;b&gt;brawn_level&lt;/b&gt; or &lt;b&gt;ballistics_level&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="7405" y="442" width="260" height="116" as="geometry"/></mxCell>
                <mxCell id="d_s2" value="&lt;i&gt;equip_str&lt;/i&gt; = apply_to_int( attacker bag, &lt;b&gt;strength_bonus&lt;/b&gt;, &lt;i&gt;attacker_stats&lt;/i&gt;[ melee_strength_bonus or projectile_strength_bonus ] )&lt;br&gt;The ammunition carries the projectile bonus." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="7695" y="449" width="250" height="102" as="geometry"/></mxCell>
                <mxCell id="d_s3" value="&lt;b&gt;combat_calc.max_hit&lt;/b&gt;&lt;br&gt;&lt;i&gt;raw&lt;/i&gt; = floor( 0.5 + &lt;i&gt;eff_str&lt;/i&gt; x (&lt;i&gt;equip_str&lt;/i&gt; + 64) / 640 )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="7975" y="470" width="220" height="60" as="geometry"/></mxCell>
                <mxCell id="d_s4" value="&lt;i&gt;max_hit&lt;/i&gt; = max( 0, apply_to_int( attacker bag, &lt;b&gt;max_hit&lt;/b&gt;, &lt;i&gt;raw&lt;/i&gt; ) )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="8225" y="475" width="220" height="50" as="geometry"/></mxCell>
                <mxCell id="d_s5" value="&lt;b&gt;roll_damage&lt;/b&gt;&lt;br&gt;&lt;i&gt;rolled&lt;/i&gt; = rng.randint(0, &lt;i&gt;max_hit&lt;/i&gt;)&lt;br&gt;(second draw)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="8475" y="463" width="200" height="74" as="geometry"/></mxCell>
                <mxCell id="d_s6" value="&lt;i&gt;damage&lt;/i&gt; = max( 0, apply_to_int( attacker bag, &lt;b&gt;damage&lt;/b&gt;, &lt;i&gt;rolled&lt;/i&gt; ) )&lt;br&gt;The result keeps &lt;i&gt;max_hit&lt;/i&gt; and &lt;i&gt;rolled&lt;/i&gt; for the max hit mark." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="8705" y="463" width="240" height="74" as="geometry"/></mxCell>
                <mxCell id="o_toy" value="&lt;b&gt;toy_sword&lt;/b&gt; (priority 200): &lt;i&gt;roll&lt;/i&gt; = rng.randint(1, 20). A 1 gives &lt;i&gt;damage&lt;/i&gt; = 0 and &lt;i&gt;self_damage&lt;/i&gt; = 1. Any other face gives &lt;i&gt;damage&lt;/i&gt; = &lt;i&gt;roll&lt;/i&gt;. &lt;i&gt;max_hit&lt;/i&gt; = 20. No OSRS max hit, no Brawn, no damage channel of the attacker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="7405" y="845" width="760" height="70" as="geometry"/></mxCell>
                <mxCell id="o_bit" value="&lt;b&gt;bit_blade&lt;/b&gt; family and &lt;b&gt;blood_sword&lt;/b&gt; (priority 200): &lt;i&gt;X&lt;/i&gt; = rng.randint(0, &lt;b&gt;MAX_EXPONENT&lt;/b&gt;). &lt;i&gt;damage&lt;/i&gt; = 2^&lt;i&gt;X&lt;/i&gt; - 1. MAX_EXPONENT: broken 1, bit-blade 3, blood sword 3, MK.II 5, 0x7F 7. No OSRS max hit, no Brawn, no damage channel of the attacker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="7405" y="950" width="760" height="70" as="geometry"/></mxCell>
                <mxCell id="o_two" value="&lt;b&gt;best_of_two_rolls&lt;/b&gt; (Exterminator buff, priority 250, against the task type only): run the default damage roll two times. Keep the higher pair of (&lt;i&gt;damage&lt;/i&gt;, &lt;i&gt;rolled&lt;/i&gt;)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="7405" y="1055" width="760" height="70" as="geometry"/></mxCell>
                <mxCell id="o_giz" value="&lt;b&gt;malfunctioning_gizmo&lt;/b&gt; (the &lt;b&gt;resolve&lt;/b&gt; seam, priority 300): &lt;i&gt;roll&lt;/i&gt; = rng.randint(1, 5). Faces 1 to 4 give &lt;i&gt;damage&lt;/i&gt; = 5. Face 5 gives &lt;i&gt;self_damage&lt;/i&gt; = 5. &lt;i&gt;hit_prob&lt;/i&gt; = 1.0, damage type energy. No accuracy roll, no levels, no max hit, and no channel of the attacker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="5275" y="1160" width="1010" height="70" as="geometry"/></mxCell>
                <mxCell id="d_def" value="&lt;i&gt;damage&lt;/i&gt; &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="9035" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="d_g" value="&lt;b&gt;_apply_defender_damage&lt;/b&gt;&lt;br&gt;&lt;i&gt;damage&lt;/i&gt; = max( 0, apply_to_int( defender bag, &lt;b&gt;damage&lt;/b&gt;, &lt;i&gt;damage&lt;/i&gt; ) )&lt;br&gt;A lit Guard augment writes its cut here. This pass runs after every seam, an override included." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="9255" y="449" width="280" height="102" as="geometry"/></mxCell>
                <mxCell id="e1" value="&lt;b&gt;ammunition.spend&lt;/b&gt;&lt;br&gt;One unit leaves the quiver, on a hit and on a miss. A recovery roll with its own RNG: &lt;b&gt;AMMO_RECOVERY_CHANCE&lt;/b&gt; 0.8 drops the unit on the tile of the target. Else it breaks. Melee spends nothing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="9705" y="442" width="240" height="116" as="geometry"/></mxCell>
                <mxCell id="e2" value="&lt;b&gt;Attack moment&lt;/b&gt;&lt;br&gt;The client of the attacker gets the moment of the accuracy skill: the sound of the swing or the shot." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="9985" y="456" width="220" height="88" as="geometry"/></mxCell>
                <mxCell id="e3" value="&lt;i&gt;hit&lt;/i&gt;, and &lt;i&gt;damage&lt;/i&gt; &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="10245" y="440" width="180" height="120" as="geometry"/></mxCell>
                <mxCell id="e7" value="&lt;i&gt;damage&lt;/i&gt; &amp;lt;= 0, and no &lt;i&gt;self_damage&lt;/i&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="10245" y="210" width="180" height="120" as="geometry"/></mxCell>
                <mxCell id="e8" value="&lt;b&gt;Miss&lt;/b&gt;&lt;br&gt;The miss line to the attacker and the target, and the miss event. A hit that rolled 0 reads as a miss too." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="10485" y="233" width="250" height="74" as="geometry"/></mxCell>
                <mxCell id="e4" value="&lt;i&gt;killed&lt;/i&gt; = &lt;i&gt;damage&lt;/i&gt; &amp;gt;= HP of the target before the hit&lt;br&gt;&lt;i&gt;hp_after&lt;/i&gt; = max(0, HP - &lt;i&gt;damage&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="10505" y="470" width="230" height="60" as="geometry"/></mxCell>
                <mxCell id="e5" value="&lt;b&gt;_plan_style_xp&lt;/b&gt;&lt;br&gt;For each skill that the style names: round( rate x &lt;i&gt;damage&lt;/i&gt; ).&lt;br&gt;Rate: 4.0 for each skill. Controlled: 1.33 each. Snipe: 2.0 each. Fortitude: 1.33 in every style.&lt;br&gt;An NPC earns no XP." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="10765" y="442" width="250" height="116" as="geometry"/></mxCell>
                <mxCell id="e6" value="&lt;b&gt;Announce and pay&lt;/b&gt;&lt;br&gt;The hit line to the attacker, the target, and the room. The HP bar of the target. The max hit mark when &lt;i&gt;rolled&lt;/i&gt; &amp;gt;= &lt;i&gt;max_hit&lt;/i&gt;. Grant the XP. The swing event (hitsplat).&lt;br&gt;All of this goes out BEFORE the damage, because a dead NPC deletes itself." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="11045" y="435" width="250" height="130" as="geometry"/></mxCell>
                <mxCell id="r1" value="&lt;b&gt;at_damage&lt;/b&gt;( &lt;i&gt;amount&lt;/i&gt;, attacker, source, damage_type )&lt;br&gt;&lt;i&gt;amount&lt;/i&gt; = max(0, &lt;i&gt;amount&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="11375" y="470" width="220" height="60" as="geometry"/></mxCell>
                <mxCell id="r2" value="Record the last attacker. A self-hit records nothing.&lt;br&gt;&lt;b&gt;on_hit&lt;/b&gt;: the controller of an NPC answers, and the NPC turns on its last attacker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="11625" y="456" width="230" height="88" as="geometry"/></mxCell>
                <mxCell id="r3" value="Is god mode on for this entity?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="11885" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="r4" value="&lt;i&gt;delta&lt;/i&gt; = min(&lt;i&gt;amount&lt;/i&gt;, HP)&lt;br&gt;HP = HP - &lt;i&gt;delta&lt;/i&gt;&lt;br&gt;Add &lt;i&gt;delta&lt;/i&gt; to the share of the attacker in &lt;b&gt;damage_record&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="12085" y="463" width="230" height="74" as="geometry"/></mxCell>
                <mxCell id="r5" value="Did HP reach 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="12345" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="r3x" value="Return 0. HP does not change. The attacker is recorded already, so an immune moderator still draws aggro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="11855" y="700" width="230" height="60" as="geometry"/></mxCell>
                <mxCell id="r6" value="&lt;b&gt;at_death&lt;/b&gt;&lt;br&gt;1. The death line to the room. The damage type picks the line. A self-kill has no killer.&lt;br&gt;2. The kill objective to the quests of the killer, by &lt;b&gt;npc_key&lt;/b&gt;.&lt;br&gt;3. The Exterminator kill to EACH damage dealer. Then clear &lt;b&gt;damage_record&lt;/b&gt;.&lt;br&gt;4. The kill and death stats.&lt;br&gt;5. The loot, then the corpse.&lt;br&gt;6. Leave combat. Put out the aura and every augment.&lt;br&gt;7. Respawn. An NPC is deleted. A player goes to the respawn point with full HP and Grit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="12220" y="704" width="420" height="172" as="geometry"/></mxCell>
                <mxCell id="ek" value="&lt;i&gt;killed&lt;/i&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="12750" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="e9" value="&lt;i&gt;self_damage&lt;/i&gt; &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="13010" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="e11" value="Is the target still usable?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="13270" y="440" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="e12" value="&lt;b&gt;ACTION_RESOLVED&lt;/b&gt;&lt;br&gt;&lt;i&gt;cooldown_ticks&lt;/i&gt; = &lt;i&gt;attack_speed&lt;/i&gt; - 1. The same attack stays pending.&lt;br&gt;&lt;i&gt;attack_speed&lt;/i&gt; = weapon speed + style &lt;b&gt;attack_speed_delta&lt;/b&gt; (rapid -1), at least 1 tick. Bare hands: 4 ticks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="13520" y="449" width="270" height="102" as="geometry"/></mxCell>
                <mxCell id="ekx" value="&lt;b&gt;TARGET_INVALID&lt;/b&gt;&lt;br&gt;Drop the action and the target. The fight ends if no other live enemy is engaged. Else an NPC turns on its last attacker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="12720" y="686" width="230" height="88" as="geometry"/></mxCell>
                <mxCell id="e10" value="&lt;b&gt;_land_backfire&lt;/b&gt;&lt;br&gt;The backfire line and event. Then the Damage application box runs on the ATTACKER, with the attacker as its own attacker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="12980" y="686" width="230" height="88" as="geometry"/></mxCell>
                <mxCell id="e10b" value="Did the attacker die?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="13270" y="670" width="170" height="120" as="geometry"/></mxCell>
                <mxCell id="e10x" value="&lt;b&gt;ACTOR_INCAPACITATED&lt;/b&gt;&lt;br&gt;The fight ends for the attacker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="13240" y="877" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="e11x" value="&lt;b&gt;TARGET_INVALID&lt;/b&gt;&lt;br&gt;As for a kill." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="13240" y="247" width="230" height="46" as="geometry"/></mxCell>
                <mxCell id="title" value="Blackout combat calculation: the current implementation" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];strokeColor=none;fillColor=none;fontStyle=1;fontColor=#1A1A1A;fontSize=26;" parent="1" vertex="1"><mxGeometry x="520" y="22" width="1300" height="40" as="geometry"/></mxCell>
                <mxCell id="subtitle" value="State of the code on 11/10/2026. Sources: systems/gameplay/combat/ (combat.py, combat_calc.py, rules/, auras/), typeclasses/mixins.py, systems/gameplay/augmentation/, systems/gameplay/exterminator/buff_defs/." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="520" y="60" width="1300" height="36" as="geometry"/></mxCell>
                <mxCell id="legend" value="&lt;b&gt;Bold&lt;/b&gt; text is a name in the code. Search for it.&lt;br&gt;&lt;i&gt;Italic&lt;/i&gt; text is a variable that a later step reads.&lt;br&gt;&lt;br&gt;Rectangle: a step. Diamond: a test. Grey rounded box: an exit of the flow.&lt;br&gt;Green: accuracy. Blue: damage roll. Purple: rule overrides.&lt;br&gt;Red: damage reduction and damage application. Yellow: messages and XP.&lt;br&gt;&lt;br&gt;The numbers are the balance values of this date. They change." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="440" height="190" as="geometry"/></mxCell>
                <mxCell id="u0" value="&lt;b&gt;aura &amp;lt;name&amp;gt;&lt;/b&gt;&lt;br&gt;The aura pulses at once, then on its interval" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1"><mxGeometry x="60" y="1485" width="180" height="90" as="geometry"/></mxCell>
                <mxCell id="u1" value="&lt;i&gt;ticks_until_pulse&lt;/i&gt; &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=10;spacing=2;" parent="1" vertex="1"><mxGeometry x="280" y="1470" width="180" height="120" as="geometry"/></mxCell>
                <mxCell id="u1x" value="&lt;i&gt;ticks_until_pulse&lt;/i&gt; - 1&lt;br&gt;Wait for the next tick." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;fontColor=#333333;spacing=5;" parent="1" vertex="1"><mxGeometry x="260" y="1657" width="220" height="46" as="geometry"/></mxCell>
                <mxCell id="u2" value="&lt;i&gt;ticks_until_pulse&lt;/i&gt; = &lt;b&gt;tick_interval&lt;/b&gt; - 1&lt;br&gt;&lt;b&gt;AURA_DEFAULT_TICK_INTERVAL&lt;/b&gt; is 4 ticks: one pulse each 2.4 s." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="500" y="1493" width="230" height="74" as="geometry"/></mxCell>
                <mxCell id="u3" value="&lt;b&gt;Ring&lt;/b&gt;: the tiles inside &lt;i&gt;radius&lt;/i&gt;, by the euclidean metric.&lt;br&gt;&lt;i&gt;radius&lt;/i&gt; = aura radius (2) + the tiles of a lit Reach augment.&lt;br&gt;Targets: each live hostile in the ring." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="770" y="1479" width="250" height="102" as="geometry"/></mxCell>
                <mxCell id="u4" value="&lt;b&gt;damage_for&lt;/b&gt;&lt;br&gt;&lt;i&gt;damage&lt;/i&gt; = max( &lt;b&gt;AURA_MIN_DAMAGE&lt;/b&gt; 1, int( skill level x &lt;b&gt;damage_pct&lt;/b&gt; ) )&lt;br&gt;Righteous Fire: Fortitude x 0.10.&lt;br&gt;No accuracy roll, no seam, no modifier channel, no defender pass." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1060" y="1479" width="260" height="102" as="geometry"/></mxCell>
                <mxCell id="u5" value="For each target:&lt;br&gt;1. Give the target a combat handler. The pulse starts a fight.&lt;br&gt;2. &lt;i&gt;dealt&lt;/i&gt; = min(&lt;i&gt;damage&lt;/i&gt;, HP).&lt;br&gt;3. Send the lines, then &lt;b&gt;at_damage&lt;/b&gt;( &lt;i&gt;dealt&lt;/i&gt;, burn )." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1360" y="1479" width="250" height="102" as="geometry"/></mxCell>
                <mxCell id="u6" value="&lt;b&gt;XP&lt;/b&gt;, one time on the total of the pulse:&lt;br&gt;round( 1.33 x &lt;i&gt;total_dealt&lt;/i&gt; ) to the XP skill (Fortitude)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;" parent="1" vertex="1"><mxGeometry x="1650" y="1493" width="230" height="74" as="geometry"/></mxCell>
                <mxCell id="u7" value="&lt;b&gt;Self-burn&lt;/b&gt;, on every pulse, with or without a target:&lt;br&gt;&lt;i&gt;owed&lt;/i&gt; = &lt;i&gt;carry&lt;/i&gt; + max HP x &lt;b&gt;self_burn_pct&lt;/b&gt; (0.05)&lt;br&gt;&lt;i&gt;burn&lt;/i&gt; = ceil(&lt;i&gt;owed&lt;/i&gt;), &lt;i&gt;carry&lt;/i&gt; = &lt;i&gt;owed&lt;/i&gt; - &lt;i&gt;burn&lt;/i&gt;&lt;br&gt;&lt;b&gt;at_damage&lt;/b&gt;( &lt;i&gt;burn&lt;/i&gt;, attacker = the caster ).&lt;br&gt;The burn can kill. The death puts the aura out, and nobody gets the kill." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontSize=11;spacing=6;align=left;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1920" y="1472" width="300" height="116" as="geometry"/></mxCell>
                <mxCell id="P1_0" value="A channel is one named number of the action. Each channel has four slots: &lt;b&gt;flat_pre&lt;/b&gt;, &lt;b&gt;augment_bonus&lt;/b&gt;, &lt;b&gt;set_bonus&lt;/b&gt;, &lt;b&gt;flat_post&lt;/b&gt;. Inside one slot, the contributions add: two +10% give x1.20, not x1.21." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="2345" y="1460" width="760" height="40" as="geometry"/></mxCell>
                <mxCell id="P1_1" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:26%"&gt;Channel&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:30%"&gt;Number that it changes&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:24%"&gt;Applier&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:20%"&gt;Bag that the seam reads&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;strike_level&lt;/b&gt;, &lt;b&gt;guns_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;effective accuracy level&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_level&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;brawn_level&lt;/b&gt;, &lt;b&gt;ballistics_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;effective damage level&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_level&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;defense_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;effective Defense level&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_level&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;defender&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;attack_bonus&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;equipment attack bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_int&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;defense_bonus&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;equipment defense bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_int&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;defender&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;strength_bonus&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;equipment strength bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_int&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;max_hit&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;the max hit, after the formula&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_int, floor 0&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;damage&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;the rolled damage&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_int, floor 0&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker, then defender&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;hit_chance&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;the hit probability&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;apply_to_scalar, clamp 0.0 to 0.99&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;attacker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:26%"&gt;&lt;b&gt;attack_speed&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;declared only&lt;/td&gt;&lt;td align="left" valign="top" style="width:24%"&gt;none&lt;/td&gt;&lt;td align="left" valign="top" style="width:20%"&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="2345" y="1514" width="760" height="328" as="geometry"/></mxCell>
                <mxCell id="P1_2" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:22%"&gt;Applier&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:78%"&gt;Formula&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;&lt;b&gt;apply_to_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:78%"&gt;floor( floor( (level + flat_pre) x (1 + augment_bonus) ) x (1 + set_bonus) ) + stance + flat_post + 8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;&lt;b&gt;apply_to_int&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:78%"&gt;floor( (value + flat_pre) x (1 + augment_bonus) x (1 + set_bonus) ) + flat_post&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;&lt;b&gt;apply_to_scalar&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:78%"&gt;(value + flat_pre) x (1 + augment_bonus) x (1 + set_bonus) + flat_post&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="2345" y="1856" width="760" height="118" as="geometry"/></mxCell>
                <mxCell id="P1_3" value="An empty bag makes each applier the identity. Thus, an action with no contributor equals &lt;b&gt;combat_calc.resolve_melee_swing&lt;/b&gt;, the OSRS reference." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="2345" y="1988" width="760" height="40" as="geometry"/></mxCell>
                <mxCell id="P2_0" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:20%"&gt;Contributor&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:14%"&gt;Source&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:14%"&gt;Counts when the holder&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:22%"&gt;Channel . slot&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:30%"&gt;Amount&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;glass_cannon_amulet&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;gear, priority 100&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks with melee&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;brawn_level . flat_pre&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;floor( (Brawn - Defense) / 5 ), only when the surplus is 5 or more&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;reflex&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;accuracy level channel . augment_bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;bonus, 0.002 for each level&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;surge&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;damage level channel . augment_bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;bonus, 0.002 for each level&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;plating&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;defends&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;defense_level . augment_bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;bonus, 0.002 for each level&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;guard_melee&lt;/b&gt;, &lt;b&gt;guard_projectile&lt;/b&gt;, &lt;b&gt;guard_energy&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;defends&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;damage . augment_bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;minus bonus, 0.004 for each level, for one damage type only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;overclock&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;holds another lit augment&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;no channel&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;adds roll x share to the bonus of each other lit augment. Roll: uniform in [0.02 + 0.0005 x level, 0.15], one time when it comes online&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;accuracy_vs_type&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;Exterminator buff&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;accuracy level channel . flat_pre&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3, 5, 6, or 9 by rarity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;milestone_growth&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;Exterminator buff&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;accuracy and damage level channels . flat_pre&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;milestones after the first x 1, 2, 2, or 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;damage_for_defense&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;Exterminator buff&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks, and defends&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;max_hit . augment_bonus, and defense_bonus . augment_bonus&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;attack: +30, 45, 60, or 90% max hit. Defense: -25% of a defense bonus above 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;low_hp_max_hit&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;Exterminator buff&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;attacks&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;max_hit . flat_post&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+4, 6, 8, or 12 when the target is under 25% HP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:20%"&gt;&lt;b&gt;defense_seal&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;Exterminator buff&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;defends&lt;/td&gt;&lt;td align="left" valign="top" style="width:22%"&gt;defense_bonus . flat_pre&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+15, 23, 30, or 45&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="3205" y="1460" width="940" height="480" as="geometry"/></mxCell>
                <mxCell id="P2_1" value="Augment bonus = &lt;b&gt;pct_per_level&lt;/b&gt; x Augmentation level x (power level / 3). A buff counts only against a creature of the task type of its holder. A flat equipment bonus, such as the +10 melee strength of the Necklace of Brawn, is not a contributor. It is part of &lt;b&gt;combat_stat_bonuses&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="3205" y="1954" width="940" height="40" as="geometry"/></mxCell>
                <mxCell id="P3_0" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:28%"&gt;Axis&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:36%"&gt;Melee (MELEE_COMBAT_AXES)&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:36%"&gt;Projectile (PROJECTILE_COMBAT_AXES)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;accuracy skill&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Strike&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Guns&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;accuracy channel&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;strike_level&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;guns_level&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;damage skill&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Brawn&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Ballistics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;damage channel&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;brawn_level&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;ballistics_level&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;strength bonus key&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;melee_strength_bonus: the sum of the gear&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;projectile_strength_bonus: the ammunition&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;attack types&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;stab, slash, crush&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;light, standard, heavy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;damage type&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;melee&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;projectile&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;defense skill&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Defense&lt;/td&gt;&lt;td align="left" valign="top" style="width:36%"&gt;Defense&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="4245" y="1460" width="720" height="248" as="geometry"/></mxCell>
                <mxCell id="P3_1" value="A style names its table in &lt;b&gt;combat_axes&lt;/b&gt;. A style that names none reads the melee table. Thus, a projectile shot needs no rules class of its own." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="4245" y="1722" width="720" height="40" as="geometry"/></mxCell>
                <mxCell id="P3_2" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:22%"&gt;Style&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:14%"&gt;weapon_style&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:30%"&gt;Level boost (stance)&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:34%"&gt;XP for each point of damage&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;accurate (melee)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;accurate&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Strike&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Strike 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;aggressive (melee)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;aggressive&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Brawn&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Brawn 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;controlled (melee)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;controlled&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+1 Strike, +1 Brawn, +1 Defense&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Strike, Brawn, Defense 1.33 each, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;defensive (melee)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;defensive&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Defense&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Defense 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;accurate (bow)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;accurate&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Guns&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Guns 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;rapid (bow)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;aggressive&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;none. Attack speed -1 tick&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Ballistics 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;penetrate (bow)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;aggressive&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Ballistics&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Ballistics 4.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:22%"&gt;snipe (bow)&lt;/td&gt;&lt;td align="left" valign="top" style="width:14%"&gt;defensive&lt;/td&gt;&lt;td align="left" valign="top" style="width:30%"&gt;+3 Defense. Range +2 tiles&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;Guns 2.0, Defense 2.0, Fortitude 1.33&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="4245" y="1776" width="720" height="248" as="geometry"/></mxCell>
                <mxCell id="P4_0" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:28%"&gt;Seam&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:40%"&gt;Default (BaseActionRules)&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:32%"&gt;Replaced today by&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;contribute_modifiers&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;does nothing. Every contributor runs, with no contest&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;the gear, the augments, and five buffs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;effective_attack_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;apply_to_level on the accuracy skill&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;effective_strength_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;apply_to_level on the damage skill&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;effective_defense_level&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;apply_to_level on Defense of the defender&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;max_hit&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;the OSRS max hit, with two channels&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;accuracy&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;the OSRS rolls and the hit chance&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;roll_accuracy&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;one rng.random()&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;nothing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;roll_damage&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;uniform on 0 to max hit, then the damage channel&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;toy_sword, the bit_blade family, blood_sword, best_of_two_rolls&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:28%"&gt;&lt;b&gt;resolve&lt;/b&gt;&lt;/td&gt;&lt;td align="left" valign="top" style="width:40%"&gt;accuracy first, then damage&lt;/td&gt;&lt;td align="left" valign="top" style="width:32%"&gt;malfunctioning_gizmo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="5065" y="1460" width="720" height="288" as="geometry"/></mxCell>
                <mxCell id="P4_1" value='&lt;table border="1" cellpadding="4" style="width:100%;height:100%;border-collapse:collapse;font-size:11px;border-color:#B3B3B3;"&gt;&lt;tr&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:18%"&gt;Priority&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:34%"&gt;Tier&lt;/th&gt;&lt;th bgcolor="#EDEDED" align="left" valign="top" style="width:48%"&gt;Members today&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:18%"&gt;0&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;RULES_PRIORITY_DEFAULT&lt;/td&gt;&lt;td align="left" valign="top" style="width:48%"&gt;BaseActionRules&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:18%"&gt;100&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;RULES_PRIORITY_MODIFIER&lt;/td&gt;&lt;td align="left" valign="top" style="width:48%"&gt;glass_cannon_amulet, each lit augment&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:18%"&gt;200&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;RULES_PRIORITY_WEAPON&lt;/td&gt;&lt;td align="left" valign="top" style="width:48%"&gt;toy_sword, the bit_blade family, blood_sword&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:18%"&gt;250&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;RULES_PRIORITY_BUFF&lt;/td&gt;&lt;td align="left" valign="top" style="width:48%"&gt;each Exterminator buff, against the task type only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="left" valign="top" style="width:18%"&gt;300&lt;/td&gt;&lt;td align="left" valign="top" style="width:34%"&gt;RULES_PRIORITY_OVERRIDE&lt;/td&gt;&lt;td align="left" valign="top" style="width:48%"&gt;malfunctioning_gizmo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;strokeColor=#B3B3B3;fillColor=#FFFFFF;fontSize=11;" parent="1" vertex="1"><mxGeometry x="5065" y="1762" width="720" height="156" as="geometry"/></mxCell>
                <mxCell id="P4_2" value="The seam contest reads the contributors of the attacker only. A defender cannot replace a seam. It can only write modifiers. On a tie of priority, the slot order decides, and a buff wins against the gear." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5065" y="1932" width="720" height="40" as="geometry"/></mxCell>
                <mxCell id="P5_0" value="&lt;b&gt;Max HP&lt;/b&gt; = Fortitude level x &lt;b&gt;HP_PER_FORTITUDE_LEVEL&lt;/b&gt; (1). The cap is 127." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1460" width="580" height="26" as="geometry"/></mxCell>
                <mxCell id="P5_1" value="&lt;b&gt;HP regen&lt;/b&gt;: each &lt;b&gt;HP_REGEN_INTERVAL_SECONDS&lt;/b&gt; (60 s), each live entity below max HP gets &lt;b&gt;HP_REGEN_AMOUNT&lt;/b&gt; (1). The sweep runs in a fight and out of one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1500" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P5_2" value="With a lit Mend augment: amount = 1 / &lt;i&gt;share&lt;/i&gt;, and &lt;i&gt;share&lt;/i&gt; = clamp( 1 - the sum of the Mend bonus, 0.25, 1.0 ). The fraction carries to the next sweep." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1554" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P5_3" value="&lt;b&gt;Reach&lt;/b&gt; = weapon max_range + style range_bonus, at least 0. A fight holds while the two are inside &lt;b&gt;ENGAGEMENT_RADIUS_TILES&lt;/b&gt; (12)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1608" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P5_4" value="&lt;b&gt;Combat level&lt;/b&gt; = floor( 0.25 x (Fortitude + Defense + floor(Augmentation / 2)) + the best branch ).&lt;br&gt;Melee branch = 0.325 x (Strike + Brawn).&lt;br&gt;Projectile branch = 0.325 x (Guns + Ballistics)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1662" width="580" height="68" as="geometry"/></mxCell>
                <mxCell id="P5_5" value="&lt;b&gt;Death of a player&lt;/b&gt;: the respawn point, full HP and Grit, no XP penalty." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="5885" y="1744" width="580" height="26" as="geometry"/></mxCell>
                <mxCell id="P6_0" value="1. &lt;b&gt;CHANNEL_ATTACK_SPEED&lt;/b&gt;: no seam reads it. The cooldown reads the weapon speed and the style only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1460" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P6_1" value="2. No contributor writes the &lt;b&gt;set_bonus&lt;/b&gt; slot. No contributor writes the &lt;b&gt;attack_bonus&lt;/b&gt;, &lt;b&gt;strength_bonus&lt;/b&gt;, or &lt;b&gt;hit_chance&lt;/b&gt; channel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1514" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P6_2" value="3. The Defense boost of a style (defensive +3, controlled +1, snipe +3): &lt;b&gt;effective_defense_level&lt;/b&gt; passes a stance of 0, and no other seam reads the boost. Thus, no roll uses it. The combat options screen shows it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1568" width="580" height="54" as="geometry"/></mxCell>
                <mxCell id="P6_3" value="4. &lt;b&gt;_award_killer_xp&lt;/b&gt; is empty. A kill pays no XP of its own. All combat XP comes from damage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1636" width="580" height="26" as="geometry"/></mxCell>
                <mxCell id="P6_4" value="5. The natural 20 of the toy sword and the &amp;quot;turns into junk&amp;quot; of the gizmo need trigger hooks (on_hit, on_kill). The hooks do not exist." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1676" width="580" height="40" as="geometry"/></mxCell>
                <mxCell id="P6_5" value="6. &lt;b&gt;blood_sword&lt;/b&gt; uses the roll of the bit blade (a TODO in its file)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1730" width="580" height="26" as="geometry"/></mxCell>
                <mxCell id="P6_6" value="7. &lt;b&gt;THREAT_*&lt;/b&gt;, &lt;b&gt;SPECIAL_ENERGY_*&lt;/b&gt;, and &lt;b&gt;DAMAGE_TYPE_TOXIN&lt;/b&gt;: constants with no reader." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1770" width="580" height="26" as="geometry"/></mxCell>
                <mxCell id="P6_7" value="8. The bell-curve &lt;b&gt;roll_damage&lt;/b&gt; in combat_calc.py is a comment. The live roll is uniform." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;fontColor=#1A1A1A;spacing=4;" parent="1" vertex="1"><mxGeometry x="6565" y="1810" width="580" height="26" as="geometry"/></mxCell>
