# Cloudflare `_headers` block for the Godot web export.
#
# Include this in playblackout-site's _headers. See README.md beside this file.
#
# DELIBERATELY NO COOP/COEP. Cross-origin isolation is only needed for a
# THREADED export; this one is built with variant/thread_support=false and was
# measured booting with crossOriginIsolated:false and SharedArrayBuffer
# undefined. Adding the headers would also break embedded third-party content
# elsewhere on the site, for nothing.

/play/*
  # Godot ships no content hash in its filenames -- every build writes
  # index.wasm again -- so `immutable` would serve a stale engine to returning
  # players after a deploy. Revalidate and let ETag do the work.
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/play/index.wasm
  # Stated explicitly: a wasm served as octet-stream fails
  # instantiateStreaming, and the fallback path silently costs startup time.
  Content-Type: application/wasm

/play/*.js
  Content-Type: text/javascript; charset=utf-8

/play/index.pck
  Content-Type: application/octet-stream
