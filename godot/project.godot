; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blackout"
config/description="Graphical client for the Blackout MUD. Talks to Evennia's
godotwebsocket port; see docs/old/2026-08-25-ENG-0006-godot-option-a-plan.md."
run/main_scene="res://scenes/console.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.027451, 0.031373, 0.043137, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://ui/blackout_mark.png"
config/icon="res://ui/blackout_mark.png"

[autoload]

Evennia="*res://autoload/evennia.gd"
DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

editor/translations/UPDATE_TRANSLATION_TEMPLATES_AUTOMATICALLY=false
editor/advanced/custom_test_scene_path="res://addons/blackout_dialogue/dialogue_test_scene.tscn"
editor/advanced/extra_auto_complete_script_sources=PackedStringArray("res://addons/blackout_dialogue/dialogue_stub.gd")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/blackout_camera/plugin.cfg", "res://addons/blackout_dialogue/plugin.cfg", "res://addons/blackout_figure/plugin.cfg", "res://addons/blackout_gear/plugin.cfg", "res://addons/blackout_models/plugin.cfg", "res://addons/blackout_terrain/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[gui]

timers/tooltip_delay_sec=0.2
theme/custom="res://ui/blackout_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
