[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scenes/console.gd" id="1_console"]
[ext_resource type="PackedScene" path="res://scenes/world.tscn" id="2_world"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="3_hud"]
[ext_resource type="Script" path="res://scenes/inventory/inventory_view.gd" id="4_inv"]
[ext_resource type="PackedScene" path="res://scenes/login/login_view.tscn" id="5_login"]

; The game's output is ASCII art as often as it is prose -- the xymap, the
; dossier's fixed-width rows, every section rule. Godot's default theme font is
; proportional, which turns all of it into ragged noise. A SystemFont costs no
; vendored asset and no import step; the names are tried in order and the last
; is the generic family every platform resolves.
[sub_resource type="SystemFont" id="SystemFont_mono"]
font_names = PackedStringArray("Consolas", "Cascadia Mono", "DejaVu Sans Mono", "monospace")

[node name="Console" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_console")

[node name="Split" type="HSplitContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
split_offset = 300

[node name="Game" type="VBoxContainer" parent="Split"]
layout_mode = 2

[node name="Login" parent="Split/Game" instance=ExtResource("5_login")]
unique_name_in_owner = true
layout_mode = 2

[node name="Hud" parent="Split/Game" instance=ExtResource("3_hud")]
unique_name_in_owner = true
layout_mode = 2

[node name="Output" type="RichTextLabel" parent="Split/Game"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.85, 0.85, 0.85, 1)
; Evennia's HP bars are background colour, not glyphs -- the godotwebsocket
; contrib turns their ANSI into [bgcolor], and RichTextLabel fills the whole
; line box with it. At the default separation of 0 those rects butt straight
; into the text above and below, which reads as combat output overlapping.
theme_override_constants/line_separation = 3
theme_override_fonts/normal_font = SubResource("SystemFont_mono")
theme_override_fonts/bold_font = SubResource("SystemFont_mono")
theme_override_fonts/italics_font = SubResource("SystemFont_mono")
bbcode_enabled = true
scroll_following = true
selection_enabled = true

[node name="FindBar" type="PanelContainer" parent="Split/Game"]
unique_name_in_owner = true
layout_mode = 2

[node name="Input" type="LineEdit" parent="Split/Game"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "connect <name> <password>"
caret_blink = true

[node name="Right" type="VSplitContainer" parent="Split"]
layout_mode = 2
size_flags_horizontal = 3
split_offset = 300

[node name="WorldView" type="SubViewportContainer" parent="Split/Right"]
layout_mode = 2
size_flags_vertical = 3
stretch = true

; handle_input_locally = false is what lets right-drag and the wheel reach the
; orbit camera's _unhandled_input inside the SubViewport instead of dying at
; the container.
[node name="SubViewport" type="SubViewport" parent="Split/Right/WorldView"]
handle_input_locally = false
render_target_update_mode = 4

[node name="World" parent="Split/Right/WorldView/SubViewport" instance=ExtResource("2_world")]

[node name="Inventory" type="VBoxContainer" parent="Split/Right"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("4_inv")
